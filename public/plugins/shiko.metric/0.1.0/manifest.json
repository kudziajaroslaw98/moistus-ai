{
	"id": "shiko.metric",
	"name": "Metric",
	"version": "0.1.0",
	"apiVersion": 1,
	"author": "Shiko",
	"description": "Track a number against a target.",
	"icon": "gauge",
	"permissions": ["node:own"],
	"main": "plugin.js",
	"nodeKinds": [
		{
			"kind": "metric",
			"label": "Metric",
			"description": "Track a number against a target",
			"icon": "gauge",
			"labelField": "label",
			"fields": {
				"label": {
					"type": "string",
					"title": "Label",
					"description": "What you're measuring",
					"required": true,
					"maxLength": 80
				},
				"value": {
					"type": "number",
					"title": "Current value",
					"description": "Where it is now",
					"default": 0
				},
				"target": {
					"type": "number",
					"title": "Target",
					"description": "Where you want it to be",
					"required": true,
					"min": 0
				},
				"unit": {
					"type": "string",
					"title": "Unit",
					"description": "Shown after the number",
					"maxLength": 20
				},
				"step": {
					"type": "number",
					"title": "Step",
					"description": "How much − and + change the value",
					"default": 1,
					"min": 0
				}
			},
			"examples": [
				"Weekly active users value:1240 target:2000 unit:users step:100",
				"Beta signups value:86 target:300 step:10"
			]
		}
	]
}
